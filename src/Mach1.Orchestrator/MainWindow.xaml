<Window x:Class="Mach1.Orchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mach1 (by TAD) - Windows Orchestrator"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Border Margin="10"
          CornerRadius="10"
          BorderBrush="{StaticResource StrokeBrush}"
          BorderThickness="1"
          Background="{StaticResource BackgroundBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="8" Background="#FF1B2735" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Mach1" FontSize="15" FontWeight="Bold" Foreground="#FFF3F7FB" />
          <TextBlock Margin="8,0,0,0" Text="Recovery Deployment Console" Foreground="#FFBFD0E2" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="BtnMinimizeWindow"
                  Width="36"
                  Height="28"
                  Padding="0"
                  Margin="0,0,6,0"
                  Background="#FF2C3D51"
                  Foreground="#FFF0F6FF"
                  BorderBrush="#FF2C3D51"
                  Content="-"
                  Click="BtnMinimizeWindow_Click" />
          <Button x:Name="BtnCloseWindow"
                  Width="36"
                  Height="28"
                  Padding="0"
                  Background="#FF9E2D2D"
                  Foreground="White"
                  BorderBrush="#FF9E2D2D"
                  Content="X"
                  Click="BtnCloseWindow_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" CornerRadius="8" Padding="16" Background="#FF244460">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CONTROLLED OFFLINE DEPLOYMENT" FontSize="12" FontWeight="Bold" Foreground="#FFD6E7F7" />
          <TextBlock Text="Mach1 Recovery Configuration" FontSize="31" FontWeight="Bold" Foreground="White" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="14"
                     Foreground="#FFE8F1FB"
                     Text="Configure an offline execution profile. The recovery environment applies the selected profile after reboot." />
        </StackPanel>
        <Border Grid.Column="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="18,0,0,0"
                Background="#26FFFFFF"
                VerticalAlignment="Top">
          <TextBlock Text="Administrative Console"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="White" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.15*" />
        <ColumnDefinition Width="1.45*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,11,0" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="Profile Selection" FontSize="27" FontWeight="Bold" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Choose one deployment profile. Selection is adjusted for the detected Windows host during recovery execution." />
          </StackPanel>

          <Border Grid.Row="2" CornerRadius="13" Padding="16" Background="{StaticResource PanelAltBrush}">
            <StackPanel>
              <TextBlock Text="Deployment Profile" FontSize="19" FontWeight="SemiBold" />
              <RadioButton x:Name="RdoRecommended" Margin="0,12,0,4" GroupName="Profile" FontSize="15" Content="Recommended (balanced, production-safe defaults)" />
              <RadioButton x:Name="RdoUltra" Margin="0,0,0,4" GroupName="Profile" FontSize="15" Content="Ultra (maximum removal and aggressive tuning)" />
              <RadioButton x:Name="RdoLight" Margin="0,0,0,4" GroupName="Profile" FontSize="15" Content="Light (non-critical components only)" />
              <CheckBox x:Name="ChkVerbose" Margin="0,10,0,0" FontSize="14" Content="Verbose recovery logging" />
            </StackPanel>
          </Border>

          <Border Grid.Row="4" CornerRadius="13" Padding="16" Background="{StaticResource AccentSoftBrush}">
            <StackPanel>
              <TextBlock Text="Host Inspection" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="TxtOsInfo"
                         Margin="0,8,0,0"
                         FontSize="14"
                         Foreground="{StaticResource TextBrush}"
                         TextWrapping="Wrap"
                         Text="OS detection pending..." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="11,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2.45*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Safety and Execution" FontSize="23" FontWeight="Bold" />
            <TextBlock Margin="0,7,0,13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Configuration is saved first, then reboot occurs and processing is completed inside Recovery Environment." />

            <CheckBox x:Name="ChkBackupToggle"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Content="I confirm BETA risk and recovery-environment execution" />

            <CheckBox x:Name="ChkBackupBypass"
                      FontSize="14"
                      Content="I already backed up / This is a fresh install (bypass backup requirement)" />

            <Button x:Name="BtnCreateBackup"
                    Height="44"
                    Margin="0,14,0,9"
                    FontSize="15"
                    Content="Create Backup"
                    Click="BtnCreateBackup_Click" />

            <Button x:Name="BtnSaveConfig"
                    Height="40"
                    Margin="0,0,0,9"
                    FontSize="14"
                    Content="Save Selection"
                    Click="BtnSaveConfig_Click" />

            <Button x:Name="BtnPatch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="47"
                    Margin="0,4,0,0"
                    FontSize="16"
                    Content="Start Recovery Execution"
                    Click="BtnPatch_Click" />

            <TextBlock x:Name="TxtStatus"
                       Margin="0,16,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Mach1 (by TAD) idle." />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Updater" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,8"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Checks GitHub releases and auto-downloads matching update assets when newer versions are available." />

            <Button x:Name="BtnCheckUpdates"
                    Height="38"
                    Content="Check For Updates Now"
                    Click="BtnCheckUpdates_Click" />

            <TextBlock x:Name="TxtUpdateStatus"
                       Margin="0,12,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="No update check has run yet." />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="6" CornerRadius="12" Padding="12" Background="{StaticResource PanelAltBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Mach1 (by TAD)" FontWeight="Bold" FontSize="13" />
          <TextBlock x:Name="TxtVersion" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Release: Mach1.04166.501.CU" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   VerticalAlignment="Center"
                   Text="Auto theme + GitHub updater enabled" />
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
