<Window x:Class="Mach1.Orchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mach1 (by TAD) - Windows Orchestrator"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="18" Padding="18" Background="{StaticResource WarningBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="BETA TRACK" FontSize="12" FontWeight="Bold" Foreground="#FFF3EF" />
          <TextBlock Text="Mach1 Recovery Orchestrator" FontSize="31" FontWeight="Bold" Foreground="White" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="14"
                     Foreground="#FFE8E4"
                     Text="Offline patch pipeline with mandatory backup gates. Adjusted for Windows 10/11 behavior before reboot-to-WinRE." />
        </StackPanel>
        <Border Grid.Column="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="18,0,0,0"
                Background="#26FFFFFF"
                VerticalAlignment="Top">
          <TextBlock Text="Use at your own risk"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="White" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="1.5*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,11,0" Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="Stage 1 / Selection Console" FontSize="27" FontWeight="Bold" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Choose optimization profiles, persist config, and review host detection before patch arming." />
          </StackPanel>

          <Border Grid.Row="2" CornerRadius="13" Padding="16" Background="{StaticResource PanelAltBrush}">
            <StackPanel>
              <TextBlock Text="Optimization Packs" FontSize="19" FontWeight="SemiBold" />
              <CheckBox x:Name="ChkKernelTimer" Margin="0,12,0,2" FontSize="15" Content="Kernel and timer tuning (BCDEDIT + scheduler)" />
              <CheckBox x:Name="ChkServiceHardening" FontSize="15" Content="Service hardening for LTSC-oriented deployments" />
              <CheckBox x:Name="ChkCs2Pack" FontSize="15" Content="CS2 profile (network, GPU, input stack)" />
              <CheckBox x:Name="ChkVerbose" Margin="0,10,0,0" FontSize="15" Content="Verbose WinRE output logging" />
            </StackPanel>
          </Border>

          <Border Grid.Row="4" CornerRadius="13" Padding="16" Background="{StaticResource AccentSoftBrush}">
            <StackPanel>
              <TextBlock Text="Host Inspection" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="TxtOsInfo"
                         Margin="0,8,0,0"
                         FontSize="14"
                         Foreground="{StaticResource TextBrush}"
                         TextWrapping="Wrap"
                         Text="OS detection pending..." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="11,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2.3*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="1.35*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Safety and Execution" FontSize="23" FontWeight="Bold" />
            <TextBlock Margin="0,7,0,13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Backup is mandatory while in BETA. Patch arming remains blocked until backup and consent are complete." />

            <CheckBox x:Name="ChkBackupToggle"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Content="I confirm BETA risk and mandatory backup requirements" />

            <Button x:Name="BtnCreateBackup"
                    Height="44"
                    Margin="0,14,0,9"
                    FontSize="15"
                    Content="Create Backup (Mandatory)"
                    Click="BtnCreateBackup_Click" />

            <Button x:Name="BtnSaveConfig"
                    Height="40"
                    Margin="0,0,0,9"
                    FontSize="14"
                    Content="Save Selection"
                    Click="BtnSaveConfig_Click" />

            <Button x:Name="BtnPatch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="47"
                    Margin="0,4,0,0"
                    FontSize="16"
                    Content="Arm Reboot To Patch"
                    Click="BtnPatch_Click" />

            <TextBlock x:Name="TxtStatus"
                       Margin="0,16,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Mach1 (by TAD) idle." />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
          <StackPanel>
            <TextBlock Text="Updater" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,8"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Checks GitHub releases and auto-downloads matching update assets when newer versions are available." />

            <Button x:Name="BtnCheckUpdates"
                    Height="38"
                    Content="Check For Updates Now"
                    Click="BtnCheckUpdates_Click" />

            <TextBlock x:Name="TxtUpdateStatus"
                       Margin="0,12,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="No update check has run yet." />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="4" CornerRadius="12" Padding="12" Background="{StaticResource PanelAltBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Mach1 (by TAD)" FontWeight="Bold" FontSize="13" />
          <TextBlock x:Name="TxtVersion" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Release: Mach1.04166.501.CU" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   VerticalAlignment="Center"
                   Text="Auto theme + GitHub updater enabled" />
      </Grid>
    </Border>
  </Grid>
</Window>
