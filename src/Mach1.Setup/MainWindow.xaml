<Window x:Class="Mach1.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mach1 Setup - CU Installer"
        Width="860"
        Height="560"
        MinWidth="760"
        MinHeight="520"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" CornerRadius="12" Padding="14" Background="{StaticResource AccentBrush}">
      <StackPanel>
        <TextBlock Text="Mach1 Cumulative Update Installer" FontSize="28" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Release: Mach1.04166.501.CU" Foreground="#DCEEFF" FontSize="13" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" CornerRadius="12" Padding="18" Background="{StaticResource PanelBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Components" FontSize="19" FontWeight="SemiBold" />

        <StackPanel Grid.Row="2">
          <CheckBox x:Name="ChkInstallMain" IsChecked="True" Content="Install Main System (Mach1 Orchestrator binaries)" />
          <CheckBox x:Name="ChkInstallRecovery" IsChecked="True" Margin="0,8,0,0" Content="Install Recovery Environment engine (WinReEngine.ps1)" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Install destinations" FontSize="16" FontWeight="SemiBold" />

        <StackPanel Grid.Row="6">
          <TextBlock x:Name="TxtMainPath" Text="Main: C:\Program Files\Mach1\Orchestrator" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock x:Name="TxtRecoveryPath" Margin="0,4,0,0" Text="Recovery: C:\Mach1\WinRE\WinReEngine.ps1" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="7" x:Name="TxtLog" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Text="Ready to install cumulative update." />
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>

      <ProgressBar x:Name="InstallProgress" Grid.Column="0" Height="24" Minimum="0" Maximum="100" Value="0" />
      <Button x:Name="BtnInstall" Grid.Column="1" Content="Install" Click="BtnInstall_Click" />
      <Button x:Name="BtnLaunch" Grid.Column="3" Content="Launch Mach1" IsEnabled="False" Click="BtnLaunch_Click" />
    </Grid>
  </Grid>
</Window>
